 }
 
+static int rtl8365mb_trunk_set_hash_mapping(struct realtek_priv *priv,
+					    const u8 *member_idxs, int num)
+{
+	int hashval;
+	int ret;
+
+	for (hashval = 0; hashval < RTL8365MB_TRUNK_NUM_HASH_VALS; hashval++) {
+		u32 idx = num ? member_idxs[hashval % num] : 0;
+
+		ret = regmap_update_bits(
+			priv->map,
+			RTL8365MB_PORT_TRUNK_HASH_MAPPING_REG(hashval),
+			RTL8365MB_PORT_TRUNK_HASH_MAPPING_MASK(hashval),
+			idx << RTL8365MB_PORT_TRUNK_HASH_MAPPING_OFFSET(hashval));
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static int rtl8365mb_trunk_refresh(struct dsa_switch *ds, int group,
+				   const struct dsa_lag *lag)
+{
+	struct realtek_priv *priv = ds->priv;
+	struct rtl8365mb *mb = (struct rtl8365mb *)priv->chip_data;
+	u8 tx_idxs[RTL8365MB_TRUNK_PORTS_PER_GROUP];
+	u32 member_mask = 0;
+	struct dsa_port *dp;
+	int num_tx = 0;
+	int ret;
+
+	if (lag) {
+		dsa_lag_foreach_port(dp, ds->dst, lag) {
+			u8 idx = dp->index % RTL8365MB_TRUNK_PORTS_PER_GROUP;
+
+			member_mask |= BIT(idx);
+			if (dp->lag_tx_enabled &&
+			    num_tx < RTL8365MB_TRUNK_PORTS_PER_GROUP)
+				tx_idxs[num_tx++] = idx;
+		}
+	}
+
+	if (!member_mask)
+		mb->trunk_lag_id = 0;
+
+	/* Distribute the 16 hash values across the members that are currently
+	 * enabled for transmission, so that traffic is not blackholed on a
+	 * member whose link is down.
+	 */
+	ret = rtl8365mb_trunk_set_hash_mapping(priv, tx_idxs, num_tx);
+	if (ret)
+		return ret;
+
+	return regmap_update_bits(
+		priv->map, RTL8365MB_PORT_TRUNK_GROUP_MASK_REG,
+		RTL8365MB_PORT_TRUNK_GROUP_MASK_MASK(group),
+		member_mask << RTL8365MB_PORT_TRUNK_GROUP_MASK_OFFSET(group));
+}
+
+static int rtl8365mb_port_lag_join(struct dsa_switch *ds, int port,
+				   struct dsa_lag lag,
+				   struct netdev_lag_upper_info *info,
+				   struct netlink_ext_ack *extack)
+{
+	struct realtek_priv *priv = ds->priv;
+	struct rtl8365mb *mb = (struct rtl8365mb *)priv->chip_data;
+	int group = port / RTL8365MB_TRUNK_PORTS_PER_GROUP;
+	struct dsa_port *dp;
+	u32 hash_sel;
+	int ret;
+
+	if (!lag.id)
+		return -EOPNOTSUPP;
+
+	if (info->tx_type != NETDEV_LAG_TX_TYPE_HASH) {
+		NL_SET_ERR_MSG_MOD(extack,
+				   "Can only offload LAG using hash TX type");
+		return -EOPNOTSUPP;
+	}
+
+	switch (info->hash_type) {
+	case NETDEV_LAG_HASH_L2:
+		hash_sel = RTL8365MB_PORT_TRUNK_HASH_SMAC_MASK |
+			   RTL8365MB_PORT_TRUNK_HASH_DMAC_MASK;
+		break;
+	case NETDEV_LAG_HASH_L23:
+		hash_sel = RTL8365MB_PORT_TRUNK_HASH_SMAC_MASK |
+			   RTL8365MB_PORT_TRUNK_HASH_DMAC_MASK |
+			   RTL8365MB_PORT_TRUNK_HASH_SIP_MASK |
+			   RTL8365MB_PORT_TRUNK_HASH_DIP_MASK;
+		break;
+	case NETDEV_LAG_HASH_L34:
+		hash_sel = RTL8365MB_PORT_TRUNK_HASH_SIP_MASK |
+			   RTL8365MB_PORT_TRUNK_HASH_DIP_MASK |
+			   RTL8365MB_PORT_TRUNK_HASH_SPORT_MASK |
+			   RTL8365MB_PORT_TRUNK_HASH_DPORT_MASK;
+		break;
+	default:
+		NL_SET_ERR_MSG_MOD(extack, "Unsupported LAG hash policy");
+		return -EOPNOTSUPP;
+	}
+
+	if (!dsa_is_user_port(ds, port) ||
+	    group >= RTL8365MB_NUM_TRUNK_GROUPS) {
+		NL_SET_ERR_MSG_MOD(extack,
+				   "Only user ports 0-7 can be aggregated");
+		return -EOPNOTSUPP;
+	}
+
+	if (mb->trunk_lag_id && mb->trunk_lag_id != lag.id) {
+		NL_SET_ERR_MSG_MOD(extack,
+				   "Hardware supports a single offloaded LAG");
+		return -EOPNOTSUPP;
+	}
+
+	dsa_lag_foreach_port(dp, ds->dst, &lag) {
+		if (dp->ds != ds ||
+		    dp->index / RTL8365MB_TRUNK_PORTS_PER_GROUP != group) {
+			NL_SET_ERR_MSG_MOD(extack,
+					   "LAG members must all be within ports 0-3 or within ports 4-7");
+			return -EOPNOTSUPP;
+		}
+	}
+
+	/* Select the hash algorithm and use the hash mapping table rather
+	 * than dumb (source port based) distribution
+	 */
+	ret = regmap_update_bits(priv->map, RTL8365MB_PORT_TRUNK_CTRL_REG,
+				 RTL8365MB_PORT_TRUNK_CTRL_HASH_MASK |
+					 RTL8365MB_PORT_TRUNK_CTRL_DUMB_MASK,
+				 hash_sel);
+	if (ret)
+		return ret;
+
+	mb->trunk_lag_id = lag.id;
+
+	return rtl8365mb_trunk_refresh(ds, group, &lag);
+}
+
+static int rtl8365mb_port_lag_leave(struct dsa_switch *ds, int port,
+				    struct dsa_lag lag)
+{
+	struct realtek_priv *priv = ds->priv;
+	struct rtl8365mb *mb = (struct rtl8365mb *)priv->chip_data;
+	int group = port / RTL8365MB_TRUNK_PORTS_PER_GROUP;
+
+	if (group >= RTL8365MB_NUM_TRUNK_GROUPS || mb->trunk_lag_id != lag.id)
+		return 0;
+
+	/* The leaving port is no longer a LAG member at this point */
+	return rtl8365mb_trunk_refresh(ds, group, &lag);
+}
+
+static int rtl8365mb_port_lag_change(struct dsa_switch *ds, int port)
+{
+	struct realtek_priv *priv = ds->priv;
+	struct rtl8365mb *mb = (struct rtl8365mb *)priv->chip_data;
+	struct dsa_port *dp = dsa_to_port(ds, port);
+	int group = port / RTL8365MB_TRUNK_PORTS_PER_GROUP;
+
+	if (group >= RTL8365MB_NUM_TRUNK_GROUPS || !dp->lag ||
+	    mb->trunk_lag_id != dp->lag->id)
+		return 0;
+
+	return rtl8365mb_trunk_refresh(ds, group, dp->lag);
+}
