 		(RTL8365MB_PORT_ISOLATION_REG_BASE + (_physport))
 #define   RTL8365MB_PORT_ISOLATION_MASK			0x07FF
 
+/* Port trunking (LAG) registers. Trunk group 0 aggregates physical ports
+ * 0-3 and trunk group 1 aggregates physical ports 4-7. Both groups share a
+ * single hash-to-member mapping table, in which each of the 16 hash values
+ * maps to a member index (0-3) within the trunk group.
+ */
+#define RTL8365MB_PORT_TRUNK_CTRL_REG			0x08CF
+#define   RTL8365MB_PORT_TRUNK_CTRL_DUMB_MASK		0x0100
+#define   RTL8365MB_PORT_TRUNK_CTRL_FLOOD_MASK		0x0080
+#define   RTL8365MB_PORT_TRUNK_CTRL_HASH_MASK		0x007F
+#define   RTL8365MB_PORT_TRUNK_HASH_DPORT_MASK		0x0040
+#define   RTL8365MB_PORT_TRUNK_HASH_SPORT_MASK		0x0020
+#define   RTL8365MB_PORT_TRUNK_HASH_DIP_MASK		0x0010
+#define   RTL8365MB_PORT_TRUNK_HASH_SIP_MASK		0x0008
+#define   RTL8365MB_PORT_TRUNK_HASH_DMAC_MASK		0x0004
+#define   RTL8365MB_PORT_TRUNK_HASH_SMAC_MASK		0x0002
+#define   RTL8365MB_PORT_TRUNK_HASH_SPA_MASK		0x0001
+
+#define RTL8365MB_PORT_TRUNK_GROUP_MASK_REG		0x08D0
+#define   RTL8365MB_PORT_TRUNK_GROUP_MASK_OFFSET(_group) \
+		((_group) * 4)
+#define   RTL8365MB_PORT_TRUNK_GROUP_MASK_MASK(_group) \
+		(0xF << RTL8365MB_PORT_TRUNK_GROUP_MASK_OFFSET((_group)))
+
+#define RTL8365MB_PORT_TRUNK_HASH_MAPPING_BASE		0x08D2
+#define   RTL8365MB_PORT_TRUNK_HASH_MAPPING_REG(_hashval) \
+		(RTL8365MB_PORT_TRUNK_HASH_MAPPING_BASE + ((_hashval) >> 3))
+#define   RTL8365MB_PORT_TRUNK_HASH_MAPPING_OFFSET(_hashval) \
+		(((_hashval) & 0x7) << 1)
+#define   RTL8365MB_PORT_TRUNK_HASH_MAPPING_MASK(_hashval) \
+		(0x3 << RTL8365MB_PORT_TRUNK_HASH_MAPPING_OFFSET((_hashval)))
+
+#define RTL8365MB_NUM_TRUNK_GROUPS			2
+#define RTL8365MB_TRUNK_PORTS_PER_GROUP			4
+#define RTL8365MB_TRUNK_NUM_HASH_VALS			16
+
+/* RMA (reserved multicast address) control register for 01-80-C2-00-00-02,
+ * i.e. slow protocols such as LACP
+ */
+#define RTL8365MB_RMA_CTRL02_REG			0x0802
+#define   RTL8365MB_RMA_CTRL02_OPERATION_OFFSET		7
+#define   RTL8365MB_RMA_CTRL02_OPERATION_MASK		0x0180
+#define   RTL8365MB_RMA_OPERATION_FORWARD		0
+#define   RTL8365MB_RMA_OPERATION_TRAP_TO_CPU		1
+
 /* Dot1x registers; to put ports in UNAUTH mode so they trap on ingress */
 #define RTL8365MB_DOT1X_PORT_ENABLE_REG			0x0A80
 #define RTL8365MB_DOT1X_PORT_AUTH_REG			0x0A82
@@ -788,6 +832,7 @@ struct rtl8365mb {
 	struct mutex mib_lock;
         u16 vlan_filtering_ports;
         u16 pvid_vid[RTL8365MB_MAX_NUM_PORTS];
+	unsigned int trunk_lag_id;
